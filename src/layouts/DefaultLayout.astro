---
import BaseLayout from "./BaseLayout.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";

interface Props {
  title?: string;
  description?: string;
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <div class="site-wrapper">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  .site-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }

  main {
    flex: 1;
  }
</style>
