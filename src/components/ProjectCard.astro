---
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";
import type { Project } from "@/data/projects";

type Props = { number: string } & Project & HTMLAttributes<"article">;

const {
  number,
  title,
  description,
  technologies,
  image,
  imageAlt = "",
  youtubeId,
  projectUrl,
  sourceUrl,
  ...rest
} = Astro.props;
---

<article class="project-card" {...rest}>
  <div class="project-content">
    <p class="project-number">{number} / PROJECT</p>

    <h3>{title}</h3>

    <p class="project-description">{description}</p>

    <ul class="technologies" aria-label="Technologies used">
      {technologies.map((technology) => <li>{technology}</li>)}
    </ul>

    {
      (projectUrl || sourceUrl) && (
        <div class="project-links">
          {projectUrl && (
            <a
              class="project-link"
              href={projectUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              View project
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="link-icon"
              >
                <path d="M15 3h6v6" />
                <path d="M10 14 21 3" />
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              </svg>
            </a>
          )}

          {sourceUrl && (
            <a
              class="project-link"
              href={sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Source code
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="link-icon"
              >
                <path d="M15 3h6v6" />
                <path d="M10 14 21 3" />
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              </svg>
            </a>
          )}
        </div>
      )
    }
  </div>

  {
    (youtubeId || image) && (
      <div class="project-media">
        {youtubeId && image ? (
          <>
            <iframe
              class="project-video"
              src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
              title={`${title} demo`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
              loading="lazy"
              tabindex="-1"
            />

            <button
              class="video-trigger"
              type="button"
              data-video-play
              aria-label={`Play ${title} demo video`}
            >
              <Image
                src={image}
                alt={imageAlt}
                loading="lazy"
                decoding="async"
              />

              <span class="play-button" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="32"
                  height="32"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z" />
                </svg>
              </span>
            </button>
          </>
        ) : image ? (
          <Image src={image} alt={imageAlt} loading="lazy" decoding="async" />
        ) : null}
      </div>
    )
  }
</article>

<script>
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;

    const button = event.target.closest<HTMLButtonElement>("[data-video-play]");

    if (!button) return;

    const media = button.closest<HTMLElement>(".project-media");
    const iframe = media?.querySelector<HTMLIFrameElement>(".project-video");

    if (!media || !iframe) return;

    iframe.src = `${iframe.src}${iframe.src.includes("?") ? "&" : "?"}autoplay=1`;
    media.classList.add("is-playing");
  });
</script>

<style>
  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-8);
    padding: var(--space-4);
    border-radius: 1.5rem;
    background: var(--color-surface);
  }

  .project-content {
    min-width: 0;
  }

  .project-number {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .project-description {
    color: var(--color-muted-foreground);
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .technologies li {
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .project-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .link-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .project-media {
    position: relative;
    width: 100%;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-background);
  }

  .project-media > img,
  .video-trigger,
  .project-video {
    display: block;
    width: 100%;
    height: 100%;
  }

  .project-media > img {
    object-fit: cover;
    object-position: center;
  }

  .video-trigger {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .project-media.is-playing .video-trigger {
    display: none;
  }

  .video-trigger > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 4rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    color: white;
    background: var(--color-background);
    transform: translate(-50%, -50%);
    transition: background-color 180ms ease;
  }

  .play-button svg {
    color: var(--color-primary);
  }

  .video-trigger:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -3px;
  }

  .project-video {
    border: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .technologies li:hover {
      color: var(--color-foreground);
      background-color: var(--color-muted);
    }

    .project-link:hover {
      color: var(--color-accent);
    }

    .video-trigger:hover .play-button {
      background: oklch(from var(--color-background) l c h / 0.9);
    }
  }

  @media (max-width: 768px) {
    .project-card {
      grid-template-columns: minmax(0, 1fr);
    }

    .project-media {
      grid-row: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-link,
    .play-button {
      transition: none;
    }
  }
</style>
