---
const socialLinks = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/andrejtosheski/" },
  { label: "GitHub", href: "https://github.com/atoshdotdev" },
  { label: "X", href: "https://x.com/atoshdev" },
  { label: "YouTube", href: "https://www.youtube.com/@atoshdotdev" },
];
---

<footer id="contact" aria-labelledby="footer-title">
  <div class="footer-inner">
    <div class="footer-contact">
      <p class="eyebrow">Have something in mind?</p>
      <h2 id="footer-title">Feel free to reach out.</h2>
      <p class="contact-copy">
        Whether you want to say hello, share an idea, or start a conversation,
        I&rsquo;d love to hear from you.
      </p>
      <a class="contact-link" href="mailto:hello@atosh.dev">
        hello@atosh.dev
      </a>
    </div>

    <div class="footer-links">
      <nav aria-label="Social links">
        <p class="eyebrow">Find me online</p>
        <ul class="social-links">
          {
            socialLinks.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  aria-label={label}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="footer-meta">
    <span>&copy; <span id="copyright-year"></span> atosh.dev</span>
  </div>
</footer>

<script>
  const yearElement = document.getElementById("copyright-year");

  if (yearElement) {
    yearElement.textContent = new Date().getFullYear().toString();
  }
</script>

<style>
  footer {
    padding: var(--space-20) var(--page-gutter);
    border-top: var(--border-width) solid var(--color-border);
    background:
      radial-gradient(
        circle at 80% 0%,
        color-mix(in oklch, var(--color-accent) 12%, transparent),
        transparent 34rem
      ),
      var(--color-surface);
  }

  .footer-inner,
  .footer-meta {
    width: 100%;
    max-width: var(--content-width-lg);
    margin-inline: auto;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(12rem, 0.6fr);
    gap: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .eyebrow {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .contact-copy {
    max-width: 30rem;
    color: var(--color-muted-foreground);
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-foreground);
    font-size: var(--text-lg);
    text-decoration: none;
  }

  .footer-links {
    align-self: end;
  }

  .social-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social-links a {
    display: block;
    width: fit-content;
    padding-block: var(--space-2);
    color: var(--color-muted-foreground);
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-link {
      transition:
        color 150ms ease,
        gap 150ms ease;
    }

    .contact-link:hover {
      gap: var(--space-4);
      color: var(--color-primary);
    }

    .social-links a {
      transition:
        color 150ms ease,
        transform 150ms ease;
    }

    .social-links a:hover {
      color: var(--color-foreground);
      transform: translateX(var(--space-1));
    }
  }

  .footer-meta {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
    color: var(--color-muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .footer-meta::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--border-width);
    background: linear-gradient(
      90deg,
      var(--color-primary) 0%,
      var(--color-primary) 10%,
      transparent 100%
    );
    content: "";
  }

  @media (max-width: 768px) {
    footer {
      padding-block: var(--space-16);
    }

    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
      padding-bottom: var(--space-12);
    }

    .footer-links {
      align-self: start;
    }
  }

  @media (max-width: 480px) {
    .footer-meta {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>
