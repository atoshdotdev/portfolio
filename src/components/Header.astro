---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import Button from "./ui/Button.astro";

const navLinks = [
  { label: "About", href: "/#about", section: "about" },
  { label: "Projects", href: "/#projects", section: "projects" },
  { label: "Experience", href: "/#experience", section: "experience" },
  { label: "Blog", href: "/blog" },
];
---

<header>
  <nav class="header-inner" aria-label="Main navigation">
    <a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
      atosh<span class="brand-dot">.</span>
    </a>

    <div class="internal-links">
      {
        navLinks.map(({ label, href, section }) => (
          <HeaderLink href={href} data-section-link={section}>
            {label}
          </HeaderLink>
        ))
      }
    </div>

    <Button
      id="mobile-menu-toggle"
      class="menu-toggle"
      type="button"
      variant="icon"
      size="md"
      ariaLabel="Open navigation menu"
      ariaExpanded={false}
      ariaControls="mobile-menu"
    >
      <svg
        class="menu-icon menu-icon-open"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"
        ></path></svg
      >

      <svg
        class="menu-icon menu-icon-close"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
      >
    </Button>

    <div class="mobile-menu" id="mobile-menu" hidden>
      {
        navLinks.map(({ label, href, section }) => (
          <HeaderLink
            href={href}
            data-section-link={section}
            class="mobile-menu-link"
          >
            {label}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          </HeaderLink>
        ))
      }
    </div>
  </nav>

  <button
    class="menu-backdrop"
    id="menu-backdrop"
    type="button"
    aria-label="Close navigation menu"
    hidden></button>
</header>

<script src="../scripts/mobile-menu-toggle.ts"></script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding-inline: var(--page-gutter);
    background: var(--color-background);
  }

  header::before {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-primary) 45%,
      var(--color-primary) 50%,
      transparent 55%
    );
    background-size: 200% 100%;
    content: "";
    animation: border-glow 8s linear infinite;
    pointer-events: none;
  }

  @keyframes border-glow {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: -100% 0;
    }
  }

  .header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    max-width: var(--content-width-lg);
    min-height: 80px;
    margin-inline: auto;
  }

  .brand {
    flex-shrink: 0;
    color: var(--color-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .brand-dot {
    color: var(--color-primary);
  }

  .internal-links {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .brand:focus-visible {
    border-radius: var(--radius-sm);
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  .menu-toggle {
    display: none;
    position: relative;
    border-color: transparent;
  }

  .menu-icon {
    position: absolute;
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .menu-toggle[aria-expanded="true"] .menu-icon-open {
    opacity: 0;
    transform: rotate(90deg);
  }

  .menu-toggle[aria-expanded="true"] .menu-icon-close {
    opacity: 1;
    transform: rotate(0);
  }

  .menu-icon-open {
    opacity: 1;
    transform: rotate(0);
  }

  .menu-icon-close {
    opacity: 0;
    transform: rotate(-90deg);
  }

  .mobile-menu[hidden],
  .menu-backdrop[hidden] {
    display: none;
  }

  .mobile-menu-link {
    position: relative;
    padding-block: var(--space-4);
    font-size: var(--text-lg);
  }

  .mobile-menu-link:not(:last-child)::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: var(--border-width);
    background: linear-gradient(
      90deg,
      var(--color-border) 0%,
      var(--color-border) 25%,
      transparent 100%
    );
    content: "";
  }

  .mobile-menu-link .icon {
    width: 1rem;
    height: 1rem;
    margin-left: auto;
  }

  @media (max-width: 768px) {
    .header-inner {
      min-height: 68px;
      gap: 0.5rem;
    }

    .internal-links {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .menu-backdrop:not([hidden]) {
      position: fixed;
      inset: 68px 0 0;
      z-index: 1;
      display: block;
      width: 100%;
      padding: 0;
      border: 0;
      background: oklch(from var(--color-background) l c h / 0.9);
      animation: backdrop-enter 180ms ease-out both;
    }

    .mobile-menu:not([hidden]) {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      z-index: 2;
      display: flex;
      flex-direction: column;
      margin-top: var(--space-4);
      padding-inline: var(--space-6);
      padding-block: var(--space-2);
      border: 1px solid var(--color-border);
      border-radius: 1.5rem;
      background: var(--color-surface);
      backdrop-filter: blur(8px);
      animation: menu-enter 180ms ease-out both;
    }
  }

  @keyframes backdrop-enter {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes menu-enter {
    from {
      opacity: 0;
      transform: translateY(-16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    header::before,
    .menu-backdrop:not([hidden]),
    .mobile-menu:not([hidden]) {
      animation: none;
    }

    .menu-icon {
      transition: none;
    }
  }
</style>
