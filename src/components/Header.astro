---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header>
  <nav>
    <h2><a href="/">{SITE_TITLE}</a></h2>

    <div class="nav-links">
      <div class="internal-links">
        <HeaderLink href="/">Home</HeaderLink>
        <HeaderLink href="/blog">Blog</HeaderLink>
        <HeaderLink href="/about">About</HeaderLink>
      </div>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Switch to light theme"
        title="Switch theme"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-sun preview-icon"
          ><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path
            d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path
            d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path
            d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path
            d="m19.07 4.93-1.41 1.41"></path></svg
        >
      </button>
    </div>
  </nav>
</header>

<script>
  const themeToggle =
    document.querySelector<HTMLButtonElement>("#theme-toggle");

  function getTheme(): "light" | "dark" {
    return document.documentElement.dataset.theme === "light"
      ? "light"
      : "dark";
  }

  function updateThemeToggle(theme: "light" | "dark") {
    if (!themeToggle) return;

    const isDark = theme === "dark";

    themeToggle.setAttribute(
      "aria-label",
      isDark ? "Switch to light theme" : "Switch to dark theme",
    );

    themeToggle.innerHTML = isDark
      ? `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sun preview-icon"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>`
      : `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-moon preview-icon"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/></svg>`;
  }

  themeToggle?.addEventListener("click", () => {
    const nextTheme = getTheme() === "dark" ? "light" : "dark";

    document.documentElement.dataset.theme = nextTheme;
    updateThemeToggle(nextTheme);

    const icon = themeToggle.querySelector("svg");

    if (icon) {
      icon.classList.add("theme-icon--animate");

      icon.addEventListener(
        "animationend",
        () => icon.classList.remove("theme-icon--animate"),
        { once: true },
      );
    }

    try {
      localStorage.setItem("theme", nextTheme);
    } catch {
      // Intentionally empty: Theme persistence is optional
    }
  });

  updateThemeToggle(getTheme());
</script>

<style>
  header {
    background: var(--color-background);
    margin: 0;
    padding: 0 1rem;
  }

  h2 {
    margin: 0;
    font-size: 1em;
  }

  h2 a,
  h2 a.active {
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  nav a {
    padding: 1em 0.5em;
    color: var(--color-foreground);
    border-bottom: 4px solid transparent;
    text-decoration: none;
  }

  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--color-primary);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .internal-links {
    display: flex;
    align-items: center;
  }

  #theme-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: var(--color-foreground);
    background: transparent;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-full);
    transition:
      background-color 150ms ease,
      transform 100ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    #theme-toggle:hover {
      background-color: var(--color-surface-hover);
    }
  }

  #theme-toggle:active {
    transform: scale(0.94);
    background-color: var(--color-surface-hover);
  }

  #theme-toggle:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  @keyframes theme-icon-enter {
    from {
      opacity: 0;
      transform: rotate(-35deg) scale(0.75);
    }

    to {
      opacity: 1;
      transform: rotate(0) scale(1);
    }
  }

  :global(#theme-toggle svg.theme-icon--animate) {
    animation: theme-icon-enter 220ms ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    #theme-toggle {
      transition: none;
    }

    :global(#theme-toggle svg.theme-icon--animate) {
      animation: none;
    }
  }

  @media (max-width: 480px) {
    .nav-links {
      gap: 0;
    }

    nav a {
      padding-inline: var(--space-2);
    }
  }
</style>
