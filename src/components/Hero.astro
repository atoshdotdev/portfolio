---
import { Image } from "astro:assets";
import ProfilePhoto from "@/assets/images/profile-photo.jpeg";
import Button from "@/components/ui/Button.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-content">
    <div class="hero-text">
      <Image
        class="hero-portrait"
        src={ProfilePhoto}
        alt="Portrait of Andrej Tosheski"
        loading="eager"
        fetchpriority="high"
      />

      <h1 id="hero-title">
        Andrej Tosheski
        <span>Software engineer</span>
      </h1>
    </div>
    <div class="hero-actions">
      <Button variant="primary" href="/projects" size="lg">
        Explore my work
      </Button>

      <Button variant="secondary" href="/blog" size="lg">Read my blog</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    width: 100%;
    min-width: 0;
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: calc(100svh - 5rem);
    text-align: center;
    overflow: clip;
  }

  .hero::before {
    position: absolute;
    z-index: 0;
    top: 45%;
    left: 50%;
    width: min(1024px, 100vw);
    height: 600px;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      ellipse at center,
      color-mix(in oklch, var(--color-accent) 12%, transparent) 0%,
      color-mix(in oklch, var(--color-accent) 5%, transparent) 35%,
      transparent 70%
    );
    content: "";
    pointer-events: none;
    animation: glow-breathe 8s ease-in-out infinite alternate;
  }

  @keyframes glow-breathe {
    from {
      opacity: 0.65;
      scale: 0.95;
    }

    to {
      opacity: 1;
      scale: 1.05;
    }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-text {
    max-width: 100%;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .hero-portrait {
    width: clamp(200px, 20vw, 250px);
    aspect-ratio: 1;
    object-fit: cover;
    border: 4px solid var(--color-border);
    border-radius: var(--radius-full);
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(2.5rem, 2vw + 2rem, 4.5rem);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    letter-spacing: -0.055em;
  }

  .hero h1 span {
    position: relative;
    display: block;
    margin-top: 0.45em;
    padding-top: 0.4em;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.5em;
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.025em;
  }

  .hero h1 span::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--border-width);
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-primary) 50%,
      transparent 100%
    );
    content: "";
  }

  .hero-actions {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-12);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: calc(100svh - 4.25rem);
    }

    .hero-text {
      flex-direction: column;
      gap: var(--space-6);
    }

    .hero-actions {
      justify-content: center;
    }
  }

  @media (max-width: 380px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero::before {
      animation: none;
    }
  }
</style>
