---
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import DefaultLayout from "@/layouts/DefaultLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<DefaultLayout
  title="Blog"
  description="Notes and articles on software engineering, web development, artificial intelligence, and projects, ideas, and technologies I'm exploring."
>
  <section class="blog-index" aria-labelledby="blog-title">
    <div class="blog-intro">
      <h1 id="blog-title">Blog<span class="accent">.</span></h1>
      <p class="intro-copy">
        A collection of thoughts on software engineering, things I'm building,
        technologies I'm exploring, and lessons learned along the way.
      </p>
    </div>

    <span class="blog-list-heading">Posts</span>

    <div class="post-divider"></div>

    <ol class="post-list">
      {
        posts.map((post, index) => (
          <li>
            <a class="post-link" href={`/blog/${post.id}/`}>
              <span class="post-number" aria-hidden="true">
                {(index + 1).toString().padStart(2, "0")}
              </span>
              <span class="post-content">
                <span class="post-meta">
                  <FormattedDate date={post.data.pubDate} />
                </span>
                <span class="post-title">{post.data.title}</span>
                <span class="post-description">{post.data.description}</span>
              </span>
            </a>

            <div class="post-divider" />
          </li>
        ))
      }
    </ol>
  </section>
</DefaultLayout>

<style>
  .blog-index {
    width: 100%;
    max-width: var(--content-width-md);
    margin-inline: auto;
    padding-block: var(--space-20);
  }

  .blog-intro {
    max-width: 42rem;
    margin-bottom: clamp(4rem, 10vw, 7rem);
  }

  .blog-list-heading,
  .post-meta {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .accent {
    color: var(--color-primary);
  }

  .intro-copy {
    max-width: 35rem;
    margin: 0;
    color: var(--color-muted-foreground);
    font-size: var(--text-lg);
  }

  .blog-list-heading {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-divider {
    width: 100%;
    height: var(--border-width);
    background: linear-gradient(90deg, var(--color-border), transparent);
  }

  .post-link {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: start;
    gap: var(--space-6);
    padding-block: var(--space-8);
    color: inherit;
    text-decoration: none;
  }

  .post-number {
    color: var(--color-muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .post-content {
    display: grid;
    gap: var(--space-2);
  }

  .post-meta {
    color: var(--color-muted-foreground);
    font-size: var(--text-xs);
  }

  .post-title {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
  }

  .post-description {
    max-width: 38rem;
    color: var(--color-muted-foreground);
  }

  @media (hover: hover) and (pointer: fine) {
    .post-link:hover .post-title {
      color: var(--color-primary);
    }
  }

  @media (max-width: 768px) {
    .blog-index {
      padding-block: var(--space-16);
    }

    .post-link {
      gap: var(--space-3);
      padding-block: var(--space-6);
    }
  }
</style>
